import { useState } from 'react';

const AcessibilidadeWebProject = () => {
  const [readmeSections, setReadmeSections] = useState([
    { id: 1, content: "# Meu projeto de Acessibilidade Web", type: "heading" },
    { id: 2, content: "## Tópico 1", type: "subheading" },
    { id: 3, content: "### Introdução à Acessibilidade", type: "subheading" },
    { id: 4, content: "Este projeto demonstra boas práticas de acessibilidade web seguindo as diretrizes WCAG (Web Content Accessibility Guidelines).", type: "paragraph" },
    { id: 5, content: "## Recursos de Acessibilidade Implementados", type: "subheading" },
    { id: 6, content: "### Navegação por Teclado", type: "subheading" },
    { id: 7, content: "### Leitores de Tela", type: "subheading" },
    { id: 8, content: "### Alto Contraste", type: "subheading" },
    { id: 9, content: "## Como Contribuir", type: "subheading" }
  ]);

  const [selectedSections, setSelectedSections] = useState<number[]>([]);
  const [markdownOutput, setMarkdownOutput] = useState('');

  const toggleSection = (id: number) => {
    if (selectedSections.includes(id)) {
      setSelectedSections(selectedSections.filter(sectionId => sectionId !== id));
    } else {
      setSelectedSections([...selectedSections, id]);
    }
  };

  const generateMarkdown = () => {
    const sortedContent = selectedSections
      .map(id => readmeSections.find(section => section.id === id))
      .filter(Boolean)
      .map(section => section!.content)
      .join('\n\n');
    
    setMarkdownOutput(sortedContent);
  };

  const copyToClipboard = () => {
    navigator.clipboard.writeText(markdownOutput);
    alert('Markdown copiado para a área de transferência!');
  };

  return (
    <div className="min-h-screen bg-background p-8">
      <div className="max-w-4xl mx-auto">
        <h1 className="text-3xl font-bold text-foreground mb-8">
          Construtor de README.md - Acessibilidade Web
        </h1>
        
        <div className="grid grid-cols-1 lg:grid-cols-2 gap-8">
          {/* Seções disponíveis */}
          <div className="bg-card border border-border rounded-lg p-6">
            <h2 className="text-xl font-semibold text-foreground mb-4">
              Blocos de Conteúdo Disponíveis
            </h2>
            <p className="text-muted-foreground mb-4">
              Clique nos blocos para adicionar ao seu README
            </p>
            
            <div className="space-y-3">
              {readmeSections.map((section) => (
                <div
                  key={section.id}
                  className={`p-4 border rounded-lg cursor-pointer transition-all ${
                    selectedSections.includes(section.id)
                      ? 'border-primary bg-primary/10'
                      : 'border-border hover:border-primary/50'
                  }`}
                  onClick={() => toggleSection(section.id)}
                >
                  <div className="flex items-center">
                    <div className={`w-4 h-4 rounded-full border-2 mr-3 ${
                      selectedSections.includes(section.id)
                        ? 'bg-primary border-primary'
                        : 'border-border'
                    }`} />
                    <div className="flex-1">
                      {section.type === 'heading' && (
                        <h3 className="text-lg font-semibold text-foreground">
                          {section.content.replace('# ', '')}
                        </h3>
                      )}
                      {section.type === 'subheading' && (
                        <h4 className="text-md font-medium text-foreground">
                          {section.content.replace('## ', '').replace('### ', '')}
                        </h4>
                      )}
                      {section.type === 'paragraph' && (
                        <p className="text-sm text-muted-foreground">
                          {section.content}
                        </p>
                      )}
                    </div>
                  </div>
                </div>
              ))}
            </div>

            <button
              onClick={generateMarkdown}
              disabled={selectedSections.length === 0}
              className="w-full mt-6 bg-primary text-primary-foreground py-3 px-4 rounded-lg font-medium hover:bg-primary/90 disabled:opacity-50 disabled:cursor-not-allowed transition-colors"
            >
              Gerar Markdown
            </button>
          </div>

          {/* Preview e output */}
          <div className="bg-card border border-border rounded-lg p-6">
            <h2 className="text-xl font-semibold text-foreground mb-4">
              Preview do README.md
            </h2>
            
            {markdownOutput ? (
              <>
                <div className="bg-muted p-4 rounded-lg mb-4">
                  <pre className="text-sm text-foreground whitespace-pre-wrap">
                    {markdownOutput}
                  </pre>
                </div>
                <button
                  onClick={copyToClipboard}
                  className="w-full bg-secondary text-secondary-foreground py-3 px-4 rounded-lg font-medium hover:bg-secondary/90 transition-colors"
                >
                  Copiar para Área de Transferência
                </button>
              </>
            ) : (
              <div className="text-center py-12 text-muted-foreground">
                <div className="w-16 h-16 mx-auto mb-4 bg-muted rounded-lg flex items-center justify-center">
                  <svg className="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                  </svg>
                </div>
                <p>Selecione alguns blocos e clique em "Gerar Markdown" para ver o preview</p>
              </div>
            )}
          </div>
        </div>

        {/* Informações sobre acessibilidade */}
        <div className="mt-12 bg-muted/50 border border-border rounded-lg p-6">
          <h2 className="text-xl font-semibold text-foreground mb-4">
            💡 Dicas de Acessibilidade para seu README
          </h2>
          <div className="grid grid-cols-1 md:grid-cols-2 gap-4 text-sm">
            <div>
              <h3 className="font-medium text-foreground mb-2">Headings Semânticos</h3>
              <p className="text-muted-foreground">Use # para títulos principais, ## para subtítulos mantendo uma hierarquia lógica.</p>
            </div>
            <div>
              <h3 className="font-medium text-foreground mb-2">Texto Alternativo</h3>
              <p className="text-muted-foreground">Sempre inclua descrições alternativas para imagens usando ![alt text](image.jpg).</p>
            </div>
            <div>
              <h3 className="font-medium text-foreground mb-2">Links Descritivos</h3>
              <p className="text-muted-foreground">Use texto descritivo para links: [Visite nosso site](https://exemplo.com).</p>
            </div>
            <div>
              <h3 className="font-medium text-foreground mb-2">Listas Organizadas</h3>
              <p className="text-muted-foreground">Use listas com marcadores para informações sequenciais usando - ou *.</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  );
};

export default AcessibilidadeWebProject;
